# Copy to .env for `netlify dev` / `npm run db:migrate`. Never commit .env.
# In production these are set in the Netlify UI (Site configuration → Environment variables).

# Turns on the cart's Checkout button and the /checkout page. Public (VITE_), not a secret.
VITE_CHECKOUT_ENABLED=false

# Neon Postgres connection string (server only).
DATABASE_URL=

# Razorpay API keys — use the rzp_test_… pair until you go live (server only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose when adding the webhook in the Razorpay dashboard (server only).
RAZORPAY_WEBHOOK_SECRET=
