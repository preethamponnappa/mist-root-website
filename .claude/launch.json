{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mistroot-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "mistroot-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "mistroot-netlify",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "netlify-cli",
        "dev",
        "--offline"
      ],
      "port": 8888
    }
  ]
}
